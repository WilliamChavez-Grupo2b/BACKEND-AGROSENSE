# Variables de tools/esp32/run-demo.ps1. Copia este archivo como tools/esp32/.env.local, en la misma carpeta, y llénalo.
# Git ignora .env.local. Todo valor entre < > es un marcador: run-demo.ps1 no arranca mientras quede alguno.
# Las variables se cargan solo en los procesos del backend y del frontend, nunca en tu sesión ni en el sistema.
# Formato: CLAVE=valor, una por línea, sin comillas y sin comentarios al final de la línea.

# ---------- Base de datos: una branch de DESARROLLO de Neon, nunca producción ----------
# Host DIRECTO de la branch de desarrollo, sin "-pooler": en Neon > Connect, elige la branch y apaga "Connection pooling".
# Ejemplo de forma: ep-algo-123456.us-east-2.aws.neon.tech
DB_HOST=<host-de-la-branch-de-desarrollo>
# Nombre de la base dentro de esa branch (en Neon suele ser neondb).
DB_NAME=<nombre-de-la-base>
DB_USER=<usuario-de-la-base>
DB_PASSWORD=<clave-de-la-base>
# Host de la base de PRODUCCIÓN. Solo sirve para bloquearlo: run-demo.ps1 compara el endpoint de Neon (la parte ep-...),
# sin importar mayúsculas ni el sufijo -pooler, y se niega a arrancar si DB_HOST es esa misma base.
PROD_DB_HOST=<host-de-la-base-de-produccion>

# ---------- Secretos ----------
# Firma los tokens del backend; run-demo.ps1 le pasa el mismo valor al frontend como BACKEND_JWT_SECRET.
# Al menos 64 bytes. Para generarlo en PowerShell:
#   $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=<secreto-de-64-bytes-o-mas>
# Contraseña de la cuenta demo@agrosense.co. -PrepararBase se la asigna (SEED_USER_PASSWORD del backend); en los demás
# arranques solo se usa para pedir el estado del ESP32. Nunca se muestra en la consola.
DEMO_PASSWORD=<clave-de-la-cuenta-demo>

# ---------- ESP32 (firmware/esp32-tcp) ----------
# true lee el ESP32 por TCP; run-demo.ps1 -SinEsp32 lo apaga para el plan B sin tocar este archivo.
ESP32_TCP_ENABLED=true
# Dirección y puerto del ESP32 en su red PLANTICAS. Solo una IPv4 privada.
ESP32_TCP_HOST=192.168.4.1
ESP32_TCP_PORT=8080
# Dispositivo de la tabla devices al que pertenecen las lecturas (el de seed_demo.sql, en el cultivo Café).
ESP32_DEVICE_ID=ESP32-PLANTICAS
# Segundos que se promedian antes de guardar una lectura.
ESP32_AGGREGATE_SECONDS=60
# Puerto del ESP32 falso de run-demo.ps1 -Simulado (en 127.0.0.1). Opcional; 18080 si no está.
# ESP32_SIM_PORT=18080
# ESP32_TCP_ALLOW_LOOPBACK NO va aquí: run-demo.ps1 la rechaza. Solo -Simulado la activa, para su ESP32 falso.
# El ESP32 no tiene bomba: el riego solo se registra.
IRRIGATION_ACTUATOR=simulated
# Compensaciones del ESP32, que envía valores crudos. Por verificar con termómetro e higrómetro de referencia.
SENSOR_CALIBRATION=AIR_TEMPERATURE=-8.5:1,RELATIVE_HUMIDITY=-6:1

# ---------- Puertos en este PC ----------
BACKEND_PORT=9000
FRONTEND_PORT=8080

# ---------- Opcional: predicciones con el servicio de IA desplegado (necesita internet) ----------
# Sin ellas, el backend no pide predicciones de riego. Quita el # para usarlas.
# AI_SERVICE_URL=https://ia-agrosense.onrender.com
# AI_SERVICE_KEY=<la-INTERNAL_API_KEY-del-servicio-de-IA>
