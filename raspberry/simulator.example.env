# Copia este archivo como simulator.env y complétalo. simulator.env no se sube al repositorio: guarda la
# llave del dispositivo. Las variables de entorno con el mismo nombre tienen prioridad sobre este archivo.

# Webhook del servicio de eventos. En local: http://localhost:8100/events
EVENTS_URL=http://localhost:8100/events
# Código del dispositivo y la llave que devolvió una sola vez POST /api/devices
# (o SEED_DEVICE_KEY del backend para el dispositivo de ejemplo RPI-DEMO-01).
DEVICE_ID=RPI-DEMO-01
DEVICE_KEY=
# Segundos entre mediciones, con horario fijo; un ciclo que se alarga salta la medición siguiente.
INTERVAL_S=30

# Sensores: auto (los reales en una Raspberry Pi, simulados en cualquier otro equipo), hardware o simulated.
SENSORS=auto
# Medidas simuladas (con sensores reales se envían las del DHT22 y el sensor de suelo).
READINGS=soil_moisture,air_temperature,relative_humidity
# DHT22: pin de datos (número GPIO, no de patilla) y lecturas antes de darlo por fallido.
DHT_GPIO=4
DHT_ATTEMPTS=3
# MCP3008: bus y chip select del SPI (SPI0 CE0) y canal del sensor de suelo.
ADC_SPI_BUS=0
ADC_SPI_DEVICE=0
ADC_CHANNEL=0
# Calibración del sensor de suelo: lo que lee seco y en agua. Los da calibrate_soil.py.
SOIL_DRY_RAW=
SOIL_WET_RAW=

# Eventos que esperan mientras no hay conexión (SQLite) y cuántos se guardan como máximo.
QUEUE_FILE=queue.sqlite3
MAX_QUEUE=10000
# Cada envío: segundos de espera de la respuesta (más de lo que puede tardar el servicio de eventos con sus
# reintentos), intentos seguidos y esperas entre ellos (1 s, 2 s, 4 s... hasta el límite).
TIMEOUT_S=45
ATTEMPTS=4
FIRST_BACKOFF_S=1
MAX_BACKOFF_S=60
