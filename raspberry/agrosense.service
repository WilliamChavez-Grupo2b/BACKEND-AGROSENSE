# systemd unit of the AgroSense field device. Install (README.md, «Arranque automático»):
#   sudo cp agrosense.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now agrosense
# It assumes the user pi and the folder /home/pi/agrosense/raspberry; change both lines below if yours differ.
[Unit]
Description=AgroSense: lecturas de los sensores de campo
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=pi
# gpio and spi let the program reach the DHT22 and the MCP3008 without root.
SupplementaryGroups=gpio spi
WorkingDirectory=/home/pi/agrosense/raspberry
ExecStart=/home/pi/agrosense/raspberry/.venv/bin/python simulator.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
# Exit status 2 is a setting to fix (no DEVICE_KEY, no calibration, missing library): restarting would not help.
RestartPreventExitStatus=2
# Ctrl+C for the program: it closes the sensors and the queue before stopping.
KillSignal=SIGINT
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
