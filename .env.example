# Variables of every AgroSense service, for docker compose (copy this file to .env) or for running each
# service on its own. No value here is real: generate each secret and never commit the filled-in copy.
# A random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Values shared by two services must be equal on both sides:
#   JWT_SECRET (backend)               = BACKEND_JWT_SECRET (frontend)
#   INTERNAL_API_KEY (IA)              = AI_SERVICE_KEY (backend)
#   EVENTS_INTERNAL_KEY (backend)      = EVENTS_INTERNAL_KEY (event service)
#   EVENTS_STREAM_SECRET (backend)     = EVENTS_STREAM_SECRET (event service)
#   SEED_DEVICE_KEY (backend)          = DEVICE_KEY (tools/e2e/run_e2e.py), for the demo device only

# ---------- Database (PostgreSQL) ----------
# compose builds the JDBC address itself; when running a service alone, set DATABASE_URL too:
# DATABASE_URL=jdbc:postgresql://localhost:5432/agrosense
DATABASE_USERNAME=agrosense
DATABASE_PASSWORD=

# ---------- Backend ----------
# At least 64 bytes. Signs the users' tokens; the frontend signs its calls with the same value.
JWT_SECRET=
# Password the "seed" profile gives demo@agrosense.co.
SEED_USER_PASSWORD=
# Key the demo device RPI-DEMO-01 gets at start-up (local and test databases only).
SEED_DEVICE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8080
LOGIN_MAX_ATTEMPTS_PER_ADDRESS=0

# AI service: predictions, and the chat when AI_CHAT_VIA_SERVICE=true (false keeps the backend's own AI).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=
# Bearer token predictions sent before X-Internal-Key; still accepted by the AI service during the migration.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_MAX_ATTEMPTS=1
# How often a crop gets a prediction from its device events (0 = off).
AI_INGESTION_PREDICTION_MINUTES=30
# Sensor corrections, TYPE=offset:gain, separated by commas.
SENSOR_CALIBRATION=
# Minutes of silence before a device raises SENSOR_OFFLINE (0 = off).
ALERTS_DEVICE_SILENT_MINUTES=15
# Hourly frost check with the Open-Meteo forecast of each estate with coordinates.
ALERTS_FROST_WATCH=true
# Events per device and minute (0 = off), identical readings at 0 or 100 % before SENSOR_FAULT (0 = off), and days of
# raw readings to keep: older ones become hourly summaries and are deleted (0 = keep everything).
DEVICE_MAX_EVENTS_PER_MINUTE=60
ALERTS_STUCK_READINGS=10
READINGS_RETENTION_DAYS=0
# simulated only records each irrigation; relay also sends the order to the crop's device.
IRRIGATION_ACTUATOR=simulated
# With the relay, the longest run. Keep it equal to MAX_PUMP_ON_MS in firmware/agrosense/src/Irrigation.h.
IRRIGATION_MAX_RUN_MINUTES=5
# true lets a prediction with enough confidence start an irrigation by itself.
IRRIGATION_AI_ORDERS=false
AI_CHAT_VIA_SERVICE=true
AI_LOCAL_ANSWERS=true
AI_REQUESTS_PER_MINUTE=10

# ESP32 read over TCP (firmware/esp32-tcp: its own Wi-Fi network PLANTICAS; the PC joins it from the operating system,
# never from here, and the network's password is not written in any file of the repository). Off by default and on
# Render. ESP32_TCP_HOST must be a private IPv4 address. The readings are stored as the device ESP32_DEVICE_ID, which must
# exist in devices, one averaged reading every ESP32_AGGREGATE_SECONDS.
ESP32_TCP_ENABLED=false
ESP32_TCP_HOST=192.168.4.1
ESP32_TCP_PORT=8080
ESP32_DEVICE_ID=RPI-DEMO-01
ESP32_AGGREGATE_SECONDS=60

# Live events.
EVENTS_INTERNAL_KEY=
# At least 32 bytes; signs the 5-minute tokens of the live stream.
EVENTS_STREAM_SECRET=

# MQTT: the older way readings came in. Off.
MQTT_ENABLED=false

# ---------- AI service (IA/) ----------
# The key the backend sends as X-Internal-Key.
INTERNAL_API_KEY=
# The first provider with a key answers: OpenAI-compatible, then Claude, then Gemini. None: 503, and the
# backend answers from the farm's figures.
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
# Several models may be listed, separated by commas: the next one answers when one is out of allowance.
AI_CHAT_MODEL=qwen/qwen3.8-27b
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
# Calls per minute to the provider from the whole service, and seconds an identical question reuses its answer (0 = off).
AI_PROVIDER_REQUESTS_PER_MINUTE=60
AI_REPLY_CACHE_SECONDS=60

# ---------- Event service (event-service/) ----------
BACKEND_URL=http://localhost:9000
EVENTS_ALLOWED_ORIGINS=http://localhost:8080
BACKEND_TIMEOUT_MS=30000
# Retries when the backend stored nothing (unreachable, or 500/502/503/504); the first wait doubles each time.
BACKEND_RETRIES=3
BACKEND_RETRY_FIRST_MS=500

# ---------- Frontend ----------
BACKEND_JWT_SECRET=
# The event service's address as the browser reaches it. Empty turns live readings off.
EVENTS_PUBLIC_URL=http://localhost:8100
SESSION_COOKIE_SECURE=false
