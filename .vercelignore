# The Vercel project deploys only the frontend (see Dockerfile.vercel), which needs frontend/ and database/.
# The leading slash keeps these to the workspace root: the frontend has a Java package named "backend".
.git
/backend
/docs
**/target
**/node_modules
**/.idea
**/.vscode
**/.env
.env*.local
/agrosense-export
/temp_agrosense
/api
/IA
# Nothing else the frontend does not need: the demo tools keep a local database and logs that may hold secrets.
/tools
/firmware
/event-service
/agrosense-entrega
/.claude
/CLAUDE.md
*.log
